# Deploy-only, filtered copy of nets_synergy.db (~13MB - just the
# GROUP_QUANTITY=2/2025-26 lineups slice the live app actually queries,
# see src/pipeline/build_deploy_db.py) - small enough to commit directly,
# unlike the full 211MB working db above.
!data/nets_synergy_deploy.db

# data/stints/ is ~296MB total (raw_cache/, games/, other seasons) - almost
# all of it only used by the offline src/pipeline/ scripts (build_stints.py,
# fit_rapm.py), never read by the live app. But step2b_player_diagnostics.py's
# individual_role_sensitivity_profile() (Section D3 "Usage Elasticity", live
# on both the Player Breakdown page and the PDF report) DOES read two small
# 2025-26 files directly - confirmed the exact FileNotFoundError from the
# deployed app traces to this, not assumed. `data/stints/*` (not
# `data/stints/`) is required here: a directory-level exclusion pattern
# blocks git from ever looking inside it, so per-file negation below
# wouldn't take effect - this glob-on-contents form still lets it.
data/stints/*
!data/stints/stints_2025_26_v2.parquet
!data/stints/stints_2025_26.parquet
!data/stints/events_2025_26.parquet
AI_USAGE.md
CLAUDE.md
DIAGNOSTICS_README.md
# --- NCAA bridge data (added with the translator pipeline) -------------------
# data/raw/ alone is ~176MB of raw CBBD season dumps, and data/college/ another
# ~25MB of intermediates - all regenerable by re-running the pipeline
# (src/pipeline/ncaa_bridge/, src/college_model/), and far too heavy for a repo
# that Streamlit Community Cloud clones on every deploy.
# The whitelist below is exactly what the LIVE APP reads at runtime (see
# step5_rookie_projections.REQUIRED_FILES) - about 7.7MB. Dropping any of these
# does not shrink the repo meaningfully but does break the deployed page, so
# they are tracked deliberately rather than by accident.
# Keep the raw cache out of the deployment, except for the two compact
# ledgers the live NCAA Bridge reads to build the 2026 draft-class browser.
data/raw/*
!data/raw/cbbd/
data/raw/cbbd/*
!data/raw/cbbd/draft_picks_all.json
!data/raw/cbbd/roster_2026.json
data/nba_historical/
logs/

data/college/*
!data/college/recipes.csv
!data/college/shared_features.parquet

data/translator/*
!data/translator/holdout_predictions.csv
!data/translator/holdout_metrics.csv
!data/translator/holdout_baseline_comparison.csv
!data/translator/deployment_preprocessing.json
!data/translator/rookie_projections_full.json
!data/translator/saturation_rule_evidence.csv
!data/translator/deployment/
data/translator/deployment/*
!data/translator/deployment/manifest.json
!data/translator/deployment/posterior.npz

# Local agent/editor tooling, not part of the deliverable.
.agents/
.claude/
